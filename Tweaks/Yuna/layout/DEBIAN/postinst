#!/bin/sh
set -e

# Target rootless path for Yuna storage
STORAGE_DIR="/var/jb/Library/Application Support/Yuna"
IMAGES_DIR="$STORAGE_DIR/Images"

if [ ! -d "$IMAGES_DIR" ]; then
    mkdir -p "$IMAGES_DIR"
fi

# Fix ownership and permissions for rootless mobile user
chown -R 501:501 "$STORAGE_DIR" || true
chmod 777 "$STORAGE_DIR" || true
chmod 777 "$IMAGES_DIR" || true

exit 0
